doctype html
html(lang="en")
    head
        title Update contact info
        link(rel="stylesheet", href="/css/style.css")
    body
        .form-wrapper
            p eBook Name: #{ebookName}
            p eBook Description: #{ebookDescription}
            form(method="POST")
                label(for="newVal") New description
                input(type="text" name="newVal" required)
                input(type="submit" value="Submit")