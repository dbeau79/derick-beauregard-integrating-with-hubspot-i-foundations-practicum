//- ** This is a sample of a pug template and how it uses the data passed to it from index.js.

doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 #{title}
        a(href='http://localhost:3000/update-cobj') Add/Update these cards
        table
            tbody
                each ebook in data
                    tr
                        td #{ebook.properties.name}
                        td #{ebook.properties.ebook_description}
                        td #{ebook.properties.ebook_category}