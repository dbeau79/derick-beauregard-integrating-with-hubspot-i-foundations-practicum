doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Pets
        a.add-link(href="/update-cobj") Add to this table
        if records && records.length
            table
                thead
                    tr
                        th Name
                        th Species
                        th Bio
                tbody
                    each record in records
                        tr
                            td #{record.properties.name}
                            td #{record.properties.species}
                            td #{record.properties.bio}
        else
            p No records yet. Use the link above to add one.
